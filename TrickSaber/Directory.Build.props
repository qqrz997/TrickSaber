<?xml version="1.0" encoding="utf-8"?>
<!-- This file contains project properties used by the build. -->
<Project>

    <!-- Plugin Metadata -->
    <PropertyGroup>
        <PluginId>TrickSaber</PluginId>
        <PluginName>TrickSaber</PluginName>
        <Authors>ToniMacaroni</Authors>
        <Version>1.1.7</Version>
        <GameVersion>1.37.5</GameVersion>
        <Description>A mod for performing tricks.</Description>
        <!--<PluginIcon></PluginIcon>-->
        <!--<ProjectSource></ProjectSource>-->
        <!--<ProjectHome></ProjectHome>-->
        <!--<DonateUrl></DonateUrl>-->
    </PropertyGroup>

    <!-- Plugin Dependencies -->
    <ItemGroup>
        <DependsOn Include="BSIPA" Version="^4.3.0"/>
        <DependsOn Include="BeatSaberMarkupLanguage" Version="^1.12.0"/>
        <DependsOn Include="SiraUtil" Version="^3.1.0"/>
    </ItemGroup>

    <PropertyGroup>
        <BSMTProjectType>BSIPA</BSMTProjectType>
        <GenerateManifest>true</GenerateManifest>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' != 'Release'">
        <DisableZipRelease>true</DisableZipRelease>
    </PropertyGroup>
    
</Project>