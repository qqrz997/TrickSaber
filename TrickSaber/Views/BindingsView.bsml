<bg xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' xsi:noNamespaceSchemaLocation='https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd'>

  <vertical child-control-height='false'>
    <horizontal ignore-layout='true' anchor-pos-x='-70' anchor-pos-y='30' horizontal-fit='PreferredSize' vertical-fit='PreferredSize'>
      <image preserve-aspect='true' preferred-width='15' source='TrickSaber.Resources.LogoSmall.png' />
    </horizontal>

    <horizontal bg='panel-top' pad-left='10' pad-right='10' horizontal-fit='PreferredSize'>
      <text text='Bindings' align='Center' font-size='7' />
    </horizontal>

    <horizontal ignore-layout='true' anchor-pos-x='-70' anchor-pos-y='24' horizontal-fit='PreferredSize' vertical-fit='PreferredSize'>
      <text text='~Version' font-size='4' font-color='#FFFFFF66'/>
    </horizontal>
    <horizontal ignore-layout='true' anchor-pos-x='-50' anchor-pos-y='-30' horizontal-fit='PreferredSize' vertical-fit='PreferredSize'>
      <text text='More settings in TrickSaber.json' font-size='4.5' font-color='#FFFFFF44'/>
    </horizontal>
    <horizontal ignore-layout='true' anchor-pos-x='50' anchor-pos-y='-30' horizontal-fit='PreferredSize' vertical-fit='PreferredSize'>
      <text text='~Credits' font-size='4.5' font-color='#FFFFFF44'/>
    </horizontal>
    <horizontal ignore-layout='true' active='~MultiBindingTextActive' anchor-pos-x='0' anchor-pos-y='24' horizontal-fit='PreferredSize' vertical-fit='PreferredSize'>
      <text text='Multi Binding active' id='MultiBindingText' font-size='4.5' font-color='#e86113ff' hover-hint='You have set two inputs to the same Action, in order to perform this Action you have to press the two inputs simultaneously'/>
    </horizontal>

    <vertical ignore-layout='true' pad-top='20' spacing='0.7'
              child-control-height='false' child-expand-height='false'>
      <horizontal horizontal-fit='PreferredSize' spacing='12'>
        <list-setting preferred-width='70' text='Trigger action' value='TriggerAction' options='TrickActionOptions' apply-on-change='true' hover-hint='What happens on trigger press'/>
        <checkbox-setting preferred-width='20' text='Reverse' value='ReverseTrigger' apply-on-change='true' hover-hint='Activate action when input is released rather than pressed' />
      </horizontal>
      <horizontal horizontal-fit='PreferredSize' spacing='12'>
        <list-setting preferred-width='70' text='Grip action' value='GripAction' options='TrickActionOptions' apply-on-change='true' hover-hint='What happens on grip press'/>
        <checkbox-setting preferred-width='20' text='Reverse' value='ReverseGrip' apply-on-change='true' hover-hint='Activate action when input is released rather than pressed' />
      </horizontal>
      <horizontal horizontal-fit='PreferredSize' spacing='10'>
        <list-setting preferred-width='70' text='Thumbstick action' value='ThumbAction' options='TrickActionOptions' apply-on-change='true' hover-hint='What happens on thumbstick move'/>
        <checkbox-setting preferred-width='20' text='Reverse' value='ReverseThumbstick' apply-on-change='true' hover-hint='Activate action when input is released rather than pressed' />
      </horizontal>
    </vertical>
  </vertical>
  
</bg>